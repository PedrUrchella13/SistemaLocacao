@model IEnumerable<SistemaLocacao.Models.Movimentacao>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Filme)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Datalocacao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Datadevolucao)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cliente.ClienteId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Filme.FilmeId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Datalocacao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Datadevolucao)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.MovimentacaoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.MovimentacaoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.MovimentacaoId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
